// API credentials. Copy this file to `Secrets.xcconfig` (same directory) and
// fill in the values, then run `cd App && xcodegen generate`.
//
// Secrets.xcconfig is gitignored. Leaving any pair blank is fine: the app just
// hides that integration's controls when no client id/secret is configured.
//
// NOTE: client secrets are baked into the built binary and are extractable.
// Neither Strava's nor WHOOP's token endpoint uses PKCE for a native app, so it
// can't avoid holding them. This is acceptable only for a personal, single-user
// build.

// Strava — from your API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =

// WHOOP — from your app at https://developer.whoop.com. Set the redirect URI on
// the WHOOP app to zona://whoop-auth so it matches WhoopSecrets/WhoopOAuthConfig.
WHOOP_CLIENT_ID =
WHOOP_CLIENT_SECRET =
