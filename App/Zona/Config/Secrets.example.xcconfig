// Strava API credentials. Copy this file to `Secrets.xcconfig` (same directory)
// and fill in the values from your Strava API application at
// https://www.strava.com/settings/api — then run `cd App && xcodegen generate`.
//
// Secrets.xcconfig is gitignored. Leaving these blank is fine: the app just
// hides the "Upload to Strava" button when no client id/secret is configured.
//
// NOTE: the client secret is baked into the built binary and is extractable.
// Strava's token endpoint has no PKCE, so a native app can't avoid holding it.
// This is acceptable only for a personal, single-user build.

STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =
